  "@measurementMm": {
    "description": "A measurement and the method it was taken by. The method is NOT optional: TL and FL differ by 6-9 cm on a Kanaad, so a number on its own is one the reader cannot act on. The two are separate placeholders because they sit on different sides of the sentence in different languages, and the unit is glued to its value with a non-breaking space rather than concatenated in Dart.",
    "placeholders": {
      "value": {
        "type": "String"
      },
      "method": {
        "type": "String"
      }
    }
  },
  "measurementInch": "{value} in ({method})",
  "@measurementInch": {
    "description": "A measurement and the method it was taken by. The method is NOT optional: TL and FL differ by 6-9 cm on a Kanaad, so a number on its own is one the reader cannot act on. The two are separate placeholders because they sit on different sides of the sentence in different languages, and the unit is glued to its value with a non-breaking space rather than concatenated in Dart.",
    "placeholders": {
      "value": {
        "type": "String"
      },
      "method": {
        "type": "String"
      }
    }
  }
}
