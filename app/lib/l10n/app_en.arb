{
  "@@locale": "en",
  "appTitle": "CatchLaw",
  "@appTitle": {
    "description": "The application name, shown by the OS task switcher. The one key that is legitimately identical in all six locales: it is a product name, not a sentence."
  },
  "searchResultCount": "{count, plural, one{{count} match} other{{count} matches}}",
  "@searchResultCount": {
    "description": "Count of species matching the S5 search term. The list is capped at 40 (SPEC.md §13), so the number is always small — but the plural categories are the locale's, not the number's.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "settingsLanguage": "Language",
  "@settingsLanguage": {
    "description": "S14's label for the language control. Its value differs per locale, which is what lets a test prove the ar bundle loaded rather than silently falling back to this template."
  },
  "settingsLanguageSystemDefault": "Device language",
  "@settingsLanguageSystemDefault": {
    "description": "The null-override state: no language has been pinned, so the device decides. Phrased as a noun, not as `Follow the device` — every string in this app states what is, and never tells the reader to do something."
  },
  "settingsNumeralSystem": "Digits",
  "@settingsNumeralSystem": {
    "description": "S14's label for the numeral-system control. Not `numbers`: what the fisher picks is which digit shapes render, not whether numbers appear."
  },
  "settingsNumeralSystemAuto": "Device language default",
  "@settingsNumeralSystemAuto": {
    "description": "The `auto` value of user_profile.numeral_system: defer to whatever CLDR says for the resolved locale. Phrased as a statement about where the value comes from, never as an instruction."
  },
  "settingsNumeralSystemLatn": "Western — 0 1 2 3",
  "@settingsNumeralSystemLatn": {
    "description": "The `latn` value: Western digits always, regardless of locale. The sample digits are part of the label so the choice is visible without applying it."
  },
  "settingsNumeralSystemArab": "Arabic-Indic — ٠ ١ ٢ ٣",
  "@settingsNumeralSystemArab": {
    "description": "The `arab` value: Arabic-Indic digits (U+0660-U+0669) always. Distinct from the Persian block U+06F0-U+06F9, which this app does not offer."
  },
  "legalTextLanguageNotice": "The verbatim text of this instrument exists only in {language}.",
  "@legalTextLanguageNotice": {
    "description": "Shown beside a verbatim legal text when the reader's locale is not among the jurisdiction's legal_text_locales. A STATEMENT ABOUT THE DATA, never an instruction: it must not tell the reader to switch language, change a setting, or do anything at all. SPEC.md §9.6 — we do not translate legal text, because an unofficial translation of a penal instrument is a liability.",
    "placeholders": {
      "language": {
        "type": "String"
      }
    }
  },
  "languageName": "{code, select, ar{Arabic} en{English} es{Spanish} gl{Galician} ca{Catalan} ptBR{Brazilian Portuguese} other{English}}",
  "@languageName": {
    "description": "The name of one shipped language, IN THE READER'S OWN LANGUAGE — Galician named in Arabic, Arabic named in Galician. A select rather than six keys so the 36 cells stay under the ARB parity gate. The `other` branch exists only because ICU requires one; every shipped code has its own branch.",
    "placeholders": {
      "code": {
        "type": "String"
      }
    }
  },
  "speciesSearchLabel": "Species",
  "@speciesSearchLabel": {
    "description": "S5's persistent field label. A noun, above the rule, never a placeholder that vanishes on focus."
  },
  "speciesSearchHint": "hamour, mero, Epinephelus",
  "@speciesSearchHint": {
    "description": "Illustrative examples inside the empty field, chosen to show that a LOCAL name works — not only a scientific one."
  },
  "speciesGroupInYourZone": "In your zone",
  "@speciesGroupInYourZone": {
    "description": "The first result group. Shown first because it is the answer to the question actually being asked."
  },
  "speciesGroupElsewhere": "Elsewhere in this jurisdiction",
  "@speciesGroupElsewhere": {
    "description": "The second result group. Never hidden: a fisher who picked the wrong zone must be able to see that his fish exists, rather than being told it does not."
  },
  "speciesHintProtected": "protected",
  "@speciesHintProtected": {
    "description": "One-word row hint. A STATEMENT about the species' status under an instrument, never an instruction: no imperative, no advice about what to do with the fish. The banned lexicon is product-invariants.md §2, and it is not quoted here — check_lonja_verdict reads this file and cannot tell a prohibition from an example of one, and ARB values are never exempt."
  },
  "speciesHintClosed": "closed",
  "@speciesHintClosed": {
    "description": "One-word row hint: a closure covers today. A statement of fact, never an instruction."
  },
  "speciesNoMatchHeadline": "No species by that name",
  "@speciesNoMatchHeadline": {
    "description": "S5's empty state. States what happened; the two actions beside it are the way onward."
  },
  "speciesNoMatchBody": "The name may be spelled differently here, or the species may not be transcribed yet.",
  "@speciesNoMatchBody": {
    "description": "Why a name might not match, without blaming the reader and without promising the species is absent. Never an instruction."
  },
  "identifyThisFish": "Identify this fish",
  "@identifyThisFish": {
    "description": "The primary way onward from an empty search — S7's key. One of the three entry points §4.3 requires."
  },
  "browseByShape": "Browse by shape",
  "@browseByShape": {
    "description": "The secondary way onward from an empty search — S6."
  },
  "rulePackExpired": "These rules passed their stated end date. They are shown as published.",
  "@rulePackExpired": {
    "description": "The ochre stale bar. A STATEMENT that the data passed its end date and is shown as published. It must not tell the reader to update, check elsewhere, or do anything at all — invariant 5 shows the finding anyway."
  },
  "speciesSearchResultCount": "{count, plural, one{{count} of {total}} other{{count} of {total}}}",
  "@speciesSearchResultCount": {
    "description": "How many species matched, out of how many the jurisdiction carries. The second number is what makes the empty state's claim honest.",
    "placeholders": {
      "count": {
        "type": "int"
      },
      "total": {
        "type": "int"
      }
    }
  },
  "browseByShapeTitle": "Browse by shape",
  "@browseByShapeTitle": {
    "description": "S6's screen heading."
  },
  "browseNoSpeciesHeadline": "No species in this pack",
  "@browseNoSpeciesHeadline": {
    "description": "S6 when the pack carries no species at all. States what is, without blaming the reader."
  },
  "browseNoSpeciesBody": "This jurisdiction has no species transcribed yet.",
  "@browseNoSpeciesBody": {
    "description": "Why the grid is empty. A statement about the pack, never an instruction to the reader."
  },
  "speciesOtherNames": "Other names",
  "@speciesOtherNames": {
    "description": "S2's block of names in the other shipped locales. Set small and after the reader's own name."
  },
  "speciesScientificName": "Scientific name",
  "@speciesScientificName": {
    "description": "The binomial's label. It comes LAST on the header, because a reader who does not read Latin cannot check it."
  },
  "speciesFamilyLabel": "Family",
  "@speciesFamilyLabel": {
    "description": "The family label on S2."
  },
  "speciesPlateSemanticLabel": "Engraved plate",
  "@speciesPlateSemanticLabel": {
    "description": "What a screen reader announces the engraved plate as."
  },
  "speciesProtectedAnywhere": "Protected somewhere in this jurisdiction",
  "@speciesProtectedAnywhere": {
    "description": "S2's protection mark. A STATEMENT about where a protection exists, not a verdict about this catch and not an instruction — E10's finding is what states the rule with its citation. It says SOMEWHERE on purpose: the account page is reached before a zone is known."
  },
  "lookAlikeSectionLabel": "Easily confused with",
  "@lookAlikeSectionLabel": {
    "description": "The look-alike block's heading on S2. States that a confusion exists — it does not warn, advise or instruct."
  },
  "lookAlikeConfusedWith": "How to tell them apart",
  "@lookAlikeConfusedWith": {
    "description": "The label above the difference sentence. `What differentiates them`, not `how to avoid the mistake`: the sentence beneath describes a physical character, and the reader decides what that means."
  },
  "recentsStripLabel": "Recent here",
  "@recentsStripLabel": {
    "description": "The recents strip's heading. HERE, because recents are per zone: the six species of the Ría de Arousa are not the six of Ras Al Khaimah."
  },
  "recentsEmptyBody": "Species you open in this zone appear here.",
  "@recentsEmptyBody": {
    "description": "Shown when the strip is empty. States what will fill it — a description of the mechanism, not an instruction to go and use it."
  },
  "calibrationTitle": "Measure your screen",
  "@calibrationTitle": {
    "description": "S4's heading."
  },
  "calibrationCardExplainer": "Lay any bank card, licence or ID on the glass and drag the edge to match it.",
  "@calibrationCardExplainer": {
    "description": "What to do with the card. This is one of the very few places the app addresses an action, and it is about the DEVICE rather than about a fish — no rule, no verdict, nothing about what to keep."
  },
  "calibrationHandleLabel": "Card edge",
  "@calibrationHandleLabel": {
    "description": "What a screen reader announces the drag handle as."
  },
  "calibrationVerifyExplainer": "This bar is {measurement}. Check it against the short side of the same card.",
  "@calibrationVerifyExplainer": {
    "description": "The second step. A fit step alone measures whatever was dragged to, including a handle nudged by a palm; this asks the reader to check a bar of known length against the same card. The length is a placeholder so it is authored once in Dart rather than typed into six translations.",
    "placeholders": {
      "measurement": {
        "type": "String"
      }
    }
  },
  "calibrationVerifyBarLabel": "{measurement}",
  "@calibrationVerifyBarLabel": {
    "description": "The verify bar's own length, beside it. A placeholder only — the number and its unit are assembled by LengthDisplay and the unit key, glued with a non-breaking space. It is a pre-formatted STRING and not an int, because it carries a unit word in the locale's own digits; check_measurement check 1's `int lengthMm` rule is about a STORED length, and nothing here is stored.",
    "placeholders": {
      "measurement": {
        "type": "String"
      }
    }
  },
  "calibrationSaveAction": "Save this measurement",
  "@calibrationSaveAction": {
    "description": "Stores the measured scale."
  },
  "calibrationCancelAction": "Back one step",
  "@calibrationCancelAction": {
    "description": "Returns to the fit step. From the approved corpus in button-anatomy.md — it names the step rather than a preservation, because the preservation wordings all open with a verb invariant 2 bans."
  },
  "calibrationTooSmallScreen": "This screen is narrower than a card. Manual entry is available.",
  "@calibrationTooSmallScreen": {
    "description": "A screen narrower than a card cannot be calibrated by this method. States the fact and names the path that still works — manual entry, which never depends on a calibration."
  },
  "calibrationImplausible": "That drag measured {measurement} across the screen, which is not a card.",
  "@calibrationImplausible": {
    "description": "Shown when a drag did not trace a card. It states WHAT WAS MEASURED, because a fisher who dragged to something absurd can see it — a bare refusal leaves him looking at the same handle with no idea why nothing happened.",
    "placeholders": {
      "measurement": {
        "type": "String"
      }
    }
  },
  "unitMillimetres": "mm",
  "unitCentimetres": "cm",
  "@unitMillimetres": {
    "description": "The millimetre unit word, glued to its number with a non-breaking space at the call site. Its own key so a number and its unit are never concatenated in Dart, where the order is wrong in Arabic."
  },
  "@unitCentimetres": {
    "description": "The centimetre unit word. Same rule."
  },
  "rulerSemanticLabel": "Ruler. Reading {measurement}.",
  "rulerZeroLabel": "0",
  "@rulerSemanticLabel": {
    "description": "What a screen reader announces the ruler as. The canvas itself is excluded from semantics — a hundred tick marks is not a reading — so this sibling node carries the number. It STATES the reading and never says what it means.",
    "placeholders": {
      "measurement": {
        "type": "String"
      }
    }
  },
  "@rulerZeroLabel": {
    "description": "The zero mark, in the locale's own digits. Its own key because the numeral system is a user setting and the zero is the one label that is always visible."
  },
  "measurementCm": "{value} cm ({method})",
  "@measurementCm": {
    "description": "A measurement and the method it was taken by. The method is NOT optional: TL and FL differ by 6-9 cm on a Kanaad, so a number on its own is one the reader cannot act on. The two are separate placeholders because they sit on different sides of the sentence in different languages, and the unit is glued to its value with a non-breaking space rather than concatenated in Dart.",
    "placeholders": {
      "value": {
        "type": "String"
      },
      "method": {
        "type": "String"
      }
    }
  },
